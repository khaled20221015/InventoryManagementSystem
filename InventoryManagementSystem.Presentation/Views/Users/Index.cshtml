@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Users";

    var showDeleted = ViewData["ShowDeleted"] is true;
    var deletedCount = ViewData["DeletedCount"] as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Users</h4>

    <div class="d-flex align-items-center gap-2">
        @if (showDeleted)
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Hide deleted</a>
        }
        else if (deletedCount > 0)
        {
            <a asp-action="Index" asp-route-showDeleted="true" class="btn btn-sm btn-outline-secondary">
                Show deleted (@deletedCount)
            </a>
        }

        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">+ New User</a>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 3.5rem">#</th>
                <th>Full name</th>
                <th>Email</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                var rowNumber = 1;
            }
            @foreach (var user in Model)
            {
                <tr class="@(user.IsDeleted ? "table-light" : null)">
                    <td class="text-muted">@rowNumber</td>
                    <td class="fw-semibold @(user.IsDeleted ? "text-muted" : null)">
                        @user.FullName

                        @if (user.IsDeleted)
                        {
                            <span class="badge bg-danger ms-1">Deleted</span>
                        }
                    </td>
                    <td class="text-muted">@user.Email</td>
                    <td>
                        @if (user.Role == RoleNames.Admin)
                        {
                            <span class="badge bg-dark">@user.Role</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@user.Role</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (user.IsDeleted)
                        {
                            <form asp-action="Restore" method="post" class="js-confirm"
                                  data-confirm="Restore @user.FullName? This account will be able to sign in again with the @user.Role role.">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                            </form>
                        }
                        else if (user.IsCurrentUser)
                        {
                            <span class="text-muted small fst-italic">This is your account</span>
                        }
                        else
                        {
                            <div class="d-inline-flex gap-2 justify-content-end align-items-center">
                                <form asp-action="ChangeRole" method="post" class="d-inline-flex gap-2">
                                    <input type="hidden" name="id" value="@user.Id" />

                                    <select name="role" class="form-select form-select-sm" style="width: auto">
                                        <option value="@RoleNames.Employee" selected="@(user.Role == RoleNames.Employee)">@RoleNames.Employee</option>
                                        <option value="@RoleNames.Admin" selected="@(user.Role == RoleNames.Admin)">@RoleNames.Admin</option>
                                    </select>

                                    <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                </form>

                                <form asp-action="Delete" method="post" class="js-confirm"
                                      data-confirm="Delete @user.FullName? This account will no longer be able to sign in.">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>

                rowNumber++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.js-confirm').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!confirm(form.dataset.confirm)) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
