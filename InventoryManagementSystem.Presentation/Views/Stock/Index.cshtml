@model List<StockTransaction>
@{
    ViewData["Title"] = "Stock movements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Stock movements</h4>
    <a asp-action="Create" class="btn btn-primary">+ Record movement</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info mb-0">No stock movements recorded yet.</div>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Type</th>
                    <th class="text-end">Quantity</th>
                    <th>Recorded by</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model)
                {
                    <tr>
                        <td class="text-muted small">@transaction.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="fw-semibold">@transaction.Product?.Name</td>
                        <td>
                            @if (transaction.TransactionType == TransactionTypes.In)
                            {
                                <span class="badge bg-success">In</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Out</span>
                            }
                        </td>
                        <td class="text-end">@transaction.Quantity</td>
                        <td class="text-muted">@transaction.User?.FullName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}