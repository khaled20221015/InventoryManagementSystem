@model List<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Products</h4>

    @if (User.IsInRole(RoleNames.Admin))
    {
        <a asp-action="Create" class="btn btn-primary">+ New product</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info mb-0">No products yet.</div>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Min. level</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.Category?.Name</td>
                        <td class="text-end">@product.Price.ToString("N2")</td>
                        <td class="text-end">
                            @if (product.StockQuantity <= product.MinimumStockLevel)
                            {
                                <span class="badge bg-danger">@product.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@product.StockQuantity</span>
                            }
                        </td>
                        <td class="text-end text-muted">@product.MinimumStockLevel</td>
                        <td class="text-end">
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}