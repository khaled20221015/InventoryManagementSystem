@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Products</h4>

    @if (User.IsInRole(RoleNames.Admin))
    {
        <a asp-action="Create" class="btn btn-primary">+ New product</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search by product name..." />
    </div>

    <div class="col-md-4">
        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">All categories</option>
        </select>
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-grow-1">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div id="products-table"
     data-url="@Url.Action("Table")"
     data-search="@Model.Search"
     data-category-id="@Model.CategoryId">
    <partial name="_ProductsTable" model="Model" />
</div>

@section Scripts {
    <script src="~/js/products-pagination.js" asp-append-version="true"></script>
}
