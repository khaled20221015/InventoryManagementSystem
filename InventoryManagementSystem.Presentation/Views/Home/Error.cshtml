@{
    ViewData["Title"] = $"Error {ViewData["Code"]}";
}

<div class="text-center py-5">
    <h1 class="display-1 fw-bold text-muted">@ViewData["Code"]</h1>
    <p class="lead">@ViewData["Message"]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Back to dashboard</a>
</div>
