@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4">Dashboard</h4>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="text-muted small text-uppercase mb-1">Products</p>
                <p class="display-6 mb-0">@Model.TotalProducts</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="text-muted small text-uppercase mb-1">Categories</p>
                <p class="display-6 mb-0">@Model.TotalCategories</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="text-muted small text-uppercase mb-1">Low stock</p>
                <p class="display-6 mb-0 text-danger">@Model.LowStockProducts.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Products per category</div>
            <div class="card-body">
                <div style="height: 260px">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Stock quantity by product</div>
            <div class="card-body">
                <div style="height: 260px">
                    <canvas id="stockChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">Low stock alerts</div>

    @if (Model.LowStockProducts.Count == 0)
    {
        <div class="card-body text-muted">All products are above their minimum stock level.</div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Min. level</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.LowStockProducts)
                {
                    <tr>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.Category?.Name</td>
                        <td class="text-end"><span class="badge bg-danger">@product.StockQuantity</span></td>
                        <td class="text-end text-muted">@product.MinimumStockLevel</td>
                        <td class="text-end">
                            <a asp-controller="Stock" asp-action="Create" class="btn btn-sm btn-outline-primary">Restock</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>


        const categoryNames = @Json.Serialize(Model.CategoryNames);
        const productsPerCategory = @Json.Serialize(Model.ProductsPerCategory);
        const topProductNames = @Json.Serialize(Model.TopProductNames);
        const topProductQuantities = @Json.Serialize(Model.TopProductQuantities);

        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: categoryNames,
                datasets: [{
                    data: productsPerCategory,
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#20c997', '#fd7e14']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        new Chart(document.getElementById('stockChart'), {
            type: 'bar',
            data: {
                labels: topProductNames,
                datasets: [{
                    label: 'Stock quantity',
                    data: topProductQuantities,
                    backgroundColor: '#0d6efd',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });
    </script>
}